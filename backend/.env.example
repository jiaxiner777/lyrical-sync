# LyricalSync backend environment variables
# Copy this file to .env and fill in your own values.
# Do NOT commit the real .env file.

# Your DeepSeek (or OpenAI-compatible) API key
OPENAI_API_KEY=your_api_key_here

# Model name to use for lyric annotation
MODEL_NAME=deepseek-chat

# Base URL of the OpenAI-compatible API endpoint
API_BASE_URL=https://api.deepseek.com/v1

# Base URL of the lyrics search/fetch API
LYRICS_API_BASE_URL=https://music.163.com/api
